# ===== Discord =====
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=

# ===== Видео-провайдер =====
# Бот сам выбирает провайдера:
#   задан KIE_API_KEY -> kie.ai, иначе -> fal.ai
# Можно принудительно: PROVIDER=kie или PROVIDER=fal
#
# kie.ai (новым аккаунтам дают 80 бесплатных кредитов):
# https://kie.ai/api-key
KIE_API_KEY=

# fal.ai (нужен положительный баланс):
# https://fal.ai/dashboard/keys
FAL_KEY=

# PROVIDER=

# ===== Поведение =====
COOLDOWN_SECONDS=60
MAX_UPLOAD_MB=50
GENERATION_TIMEOUT_MS=720000
POLL_INTERVAL_MS=2500
PROGRESS_UPDATE_MS=6000

# ===== Водяной знак =====
# Накладывается локально через ffmpeg (tools/ffmpeg/ffmpeg.exe).
# WATERMARK=0 — выключить; путь к PNG можно переопределить.
WATERMARK=1
WATERMARK_PATH=assets/watermark.png
# Размер логотипа как доля ширины видео (0.16 = 16%).
WATERMARK_SCALE=0.16
WATERMARK_OPACITY=0.85
